NODE_ENV=production
POSTGRES_DB=nap_log
POSTGRES_USER=nap_log
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DATABASE_URL=postgresql://nap_log:replace-with-a-long-random-secret@postgres:5432/nap_log
REDIS_PASSWORD=replace-with-a-long-random-secret
REDIS_URL=redis://:replace-with-a-long-random-secret@redis:6379
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=nap-log-evidence
S3_ACCESS_KEY=replace-with-a-random-access-key
S3_SECRET_KEY=replace-with-a-long-random-secret
OIDC_ISSUER=https://auth.example.com/realms/nap-log
OIDC_AUDIENCE=nap-log-api
KEYCLOAK_HOSTNAME=auth.example.com
KEYCLOAK_ADMIN=replace-admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-secret
INTERNAL_SERVICE_KEY=replace-with-a-long-random-secret
INTERNAL_API_URL=http://api:3001
PUBLIC_PROOF_BASE_URL=https://api.example.com/v1/public/proofs
API_URL=http://api:3001/v1
AUTH_URL=https://app.example.com
AUTH_SECRET=replace-with-at-least-32-random-bytes
AUTH_KEYCLOAK_ID=nap-log-web
AUTH_KEYCLOAK_SECRET=replace-with-a-long-random-secret
AUTH_KEYCLOAK_ISSUER=https://auth.example.com/realms/nap-log
WEB_PORT=3000
